{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-windows",
  "version": "0.1.0",
  "identifier": "org.rcn.tauriwindows",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Windows (Tauri)",
        "width": 720,
        "height": 480,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"]
  }
}
